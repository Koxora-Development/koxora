{
  "name": "koxora/contact-endpoint",
  "description": "The Koxora website contact endpoint, served by PHP-FPM behind the existing Apache.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "symfony/mailer": "7.4.19"
  },
  "require-dev": {
    "phpunit/phpunit": "11.5.57"
  },
  "autoload": {
    "psr-4": {
      "Koxora\\Contact\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Koxora\\Contact\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.2.0"
    }
  },
  "scripts": {
    "lint": "find public src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
    "test": "phpunit"
  }
}
