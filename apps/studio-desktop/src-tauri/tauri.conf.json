{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Koxora",
  "version": "0.1.0",
  "identifier": "app.koxora.studio",
  "build": {
    "beforeDevCommand": "pnpm --filter @koxora/studio-web exec cross-env KOXORA_DESKTOP=1 vite --host 127.0.0.1",
    "beforeBuildCommand": "pnpm --filter @koxora/studio-web exec cross-env KOXORA_DESKTOP=1 vite build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../studio-web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Koxora",
        "width": 1280,
        "height": 860,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "dmg"],
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
